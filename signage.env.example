# TV signage settings. After editing, run:
#   sudo systemctl restart signage-web signage-player

# Where uploads, thumbnails and the database live
SIGNAGE_DATA_DIR=/var/lib/signage

# Web admin address and port (80 means you can browse to http://<pi-name>.local)
SIGNAGE_HOST=0.0.0.0
SIGNAGE_PORT=80

# Largest single upload in MB
SIGNAGE_MAX_UPLOAD_MB=8192

# How long a login lasts, in hours
SIGNAGE_SESSION_HOURS=12

# Hardware video decoding. "drm" uses the Pi 4's HEVC (H.265) 4K decoder and
# its H.264 1080p decoder. Set to "no" to force software decoding.
SIGNAGE_HWDEC=drm

# How mpv draws to the screen. The default draws straight to HDMI with no
# desktop (Raspberry Pi OS Lite or console boot). If you run the Pi desktop
# instead, set this to: --vo=gpu
SIGNAGE_MPV_VO=--vo=gpu --gpu-context=drm

# Sound output. vc4hdmi0 is the HDMI port nearest the USB-C power socket;
# use vc4hdmi1 for the other one. List devices with:  mpv --audio-device=help
SIGNAGE_AUDIO_DEVICE=alsa/hdmi:CARD=vc4hdmi0,DEV=0

# Any extra mpv options, e.g. --drm-mode=3840x2160@30
SIGNAGE_MPV_EXTRA=
